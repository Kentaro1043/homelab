{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": ["https://claw.kentaro1043.com"]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace"
    },
    "list": [
      {
        "id": "openai",
        "identity": {
          "name": "GPT-5.5"
        },
        "model": {
          "primary": "openai/gpt-5.5"
        }
      },
      {
        "id": "google",
        "identity": {
          "name": "Gemma 4"
        },
        "model": {
          "primary": "google/gemma-4-31b-it"
        }
      }
    ]
  },
  "cron": { "enabled": false },
  "channels": {
    "discord": {
      "enabled": true,
      "token": "${DISCORD_BOT_TOKEN}"
    }
  },
  "plugins": {
    "entries": {
      "codex": {
        "enabled": true
      }
    }
  }
}
