{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": ["https://claw.kentaro1043.com"]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "models": {
        "openai/gpt-5.6-sol": {
          "agentRuntime": {
            "id": "codex"
          }
        },
        "google/gemma-4-31b-it": {
          "alias": "gemma-4-31b"
        },
        "google/gemma-4-26b-a4b-it": {
          "alias": "gemma-4-26b"
        }
      },
      "imageGenerationModel": {
        "primary": "openai/gpt-image-2"
      }
    },
    "list": [
      {
        "id": "default",
        "identity": {
          "name": "OpenClaw Assistant"
        },
        "workspace": "~/.openclaw/workspace",
        "model": {
          "primary": "openai/gpt-5.6-sol"
        }
      }
    ]
  },
  "cron": { "enabled": true },
  "channels": {
    "discord": {
      "enabled": true,
      "token": "${DISCORD_BOT_TOKEN}",
      "groupPolicy": "allowlist",
      "guilds": {
        "1366927360435425371": {
          "requireMention": true,
          "users": ["766615423453364234"],
          "channels": {
            "1529514412417744957": {
              "requireMention": false
            }
          }
        }
      },
      "dmPolicy": "allowlist",
      "allowFrom": ["766615423453364234"]
    }
  },
  "plugins": {
    "entries": {
      "codex": {
        "enabled": true
      },
      "discord": {
        "enabled": true
      }
    }
  }
}
